# ATLAS — files that must NEVER be committed to the public repo.
# Generated 2026-11-21 during the pre-push secrets audit.

# Secrets — the wallet directory holds the Solana keypair (anyone with it
# controls the funds). The public deposit address already lives in
# config/trading.json (deposit.address), so nothing public is lost.
config/wallet/

# Runtime state (generated by the daemon; never hand-edited).
# data/atlas.db also contains private email addresses.
data/
logs/
backups/

# Third-party miner binary — fetch separately, do not vendor.
# xmrig/config-pool.json also carries the public Monero mining address.
xmrig/

# Python bytecode
__pycache__/
*.pyc

# Databases and archives
*.db
*.tar.gz

# Local overrides
*.local.json
